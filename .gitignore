# Node.js dependencies
node_modules/
client/node_modules/
server/node_modules/

# Production build outputs
dist/
client/dist/
server/dist/
build/

# Environment files and credentials (CRITICAL: never commit secrets)
.env
.env.*
*.env
server/.env
server/.env.*
!*.env.example

# Local SQLite databases (legacy fallback)
*.db
*.db-journal
server/prisma/dev.db
server/prisma/dev.db-journal

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# SSL / TLS certificates and private keys
*.pem
*.key
*.cert
