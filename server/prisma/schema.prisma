datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
}

model Category {
  id          String          @id @default(uuid())
  name        String
  slug        String          @unique
  services    Service[]
  portfolio   PortfolioItem[]
}

model Service {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  shortDesc     String
  fullDesc      String
  priceStarting Float?
  features      String   // JSON string of feature bullet points
  imageUrl      String
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model PortfolioItem {
  id          String   @id @default(uuid())
  title       String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  mediaType   String   @default("IMAGE") // IMAGE | VIDEO
  mediaUrl    String
  description String?
  location    String?  @default("Jamalpur, Munger")
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(uuid())
  clientName String
  location   String   @default("Jamalpur")
  rating     Int      @default(5)
  comment    String
  eventType  String
  eventDate  String?
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  phone      String
  email      String?
  eventType  String
  eventDate  String?
  guestCount Int?
  location   String?
  message    String
  status     String   @default("NEW") // NEW | CONTACTED | BOOKED | ARCHIVED
  createdAt  DateTime @default(now())
}

model AIPromptTemplate {
  id         String   @id @default(uuid())
  title      String
  category   String
  promptText String
  isActive   Boolean  @default(true)
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
